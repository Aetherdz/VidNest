{
  "expo": {
    "name": "VidNest",
    "slug": "vidnest",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F19"
    },
    "newArchEnabled": true,
    "supportsRTL": true,
    "designer": "Atheerium",
    "ios": {
      "bundleIdentifier": "com.atheerium.vidnest",
      "supportsTablet": true
    },
    "android": {
      "package": "com.atheerium.vidnest",
      "supportsRTL": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0F19"
      },
      "intentFilters": [
        {
          "action": "SEND",
          "category": ["DEFAULT"],
          "data": { "mimeType": "text/plain" }
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    }
  }
}
